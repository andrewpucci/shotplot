{
  "name": "shotplot",
  "version": "4.1.0",
  "description": "A tool used to obtain spacial coordinates based on an ice hockey rink",
  "author": "Andrew Pucci",
  "license": "GPL-3.0",
  "scripts": {
    "browserslist:update": "npx update-browserslist-db@latest",
    "clean": "rm -rf dist",
    "assets:build": "vite build --mode production",
    "assets:build:dev": "vite build --mode development",
    "assets:watch": "vite build --watch --mode development",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/scss/**/*.scss\"",
    "site:build:dev": "ELEVENTY_ENV=development eleventy",
    "site:build:prod": "ELEVENTY_ENV=production eleventy",
    "dev": "npm run clean && npm run assets:build:dev && (npm run assets:watch & ELEVENTY_ENV=development eleventy --serve)",
    "prod": "npm run clean && npm run assets:build && npm run site:build:prod",
    "build": "npm run prod",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed --project=chromium",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:build": "npm run clean && npm run assets:build:dev && npm run site:build:dev",
    "test:e2e:serve": "npm run test:e2e:build && node scripts/serve-dist.mjs",
    "test:e2e:codegen": "node scripts/test-e2e-codegen.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewpucci/shotplot"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "tabulator-tables": "^6.3.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@argos-ci/playwright": "^7.4.6",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.20.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.3.0",
    "jsdom": "^29.1.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.97.3",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
